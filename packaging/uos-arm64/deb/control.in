Package: com.e23aqiu.intdemo
Version: @VERSION@
Architecture: arm64
Maintainer: e23Aqiu <e23aqiu@users.noreply.github.com>
Installed-Size: @INSTALLED_SIZE@
Depends: libc6 (>= 2.28), libsecret-tools, libglib2.0-0, libdbus-1-3, libfontconfig1, libfreetype6, libx11-6, libx11-xcb1, libxcb1, libxcb-xinerama0, libxkbcommon-x11-0, libxrender1, libxi6, libxrandr2, libxfixes3, libxcursor1, libgl1, libegl1, libgbm1, libnss3, libasound2
Recommends: fonts-noto-cjk
