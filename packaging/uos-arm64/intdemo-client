#!/usr/bin/env bash
set -Eeuo pipefail

package_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
bundled_connection_config="$package_root/client-online.json"
user_config_root="${XDG_CONFIG_HOME:-$HOME/.config}/intdemo-client"
user_connection_config="$user_config_root/client-online.json"
launcher_log=""
selected_root="$package_root"
selected_version=""
pending_launch=0

valid_version() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

version_gt() {
  local left="$1"
  local right="$2"
  if command -v dpkg >/dev/null 2>&1; then
    dpkg --compare-versions "$left" gt "$right"
    return
  fi
  [[ "$left" != "$right" && "$(printf '%s\n%s\n' "$right" "$left" | sort -V | tail -n 1)" == "$left" ]]
}

layer_candidate_is_valid() {
  local version="$1"
  local candidate="$layer_store/versions/$version"
  valid_version "$version" || return 1
  version_gt "$version" "$seed_version" || return 1
  [[ -O "$candidate" ]] || return 1
  [[ -x "$candidate/app/intdemo-client" ]] || return 1
  [[ -d "$candidate/app/_internal" ]] || return 1
  [[ -x "$candidate/browser/chrome" ]] || return 1
  [[ -f "$candidate/layer-layout.json" ]] || return 1
}

seed_version=""
if [[ -r "$package_root/build-info.txt" ]]; then
  seed_version="$(
    sed -n 's/^version=\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$/\1/p' \
      "$package_root/build-info.txt" 2>/dev/null \
      | head -n 1 \
      || true
  )"
fi
valid_version "$seed_version" || seed_version="0.0.0"
if [[ -n "${INTDEMO_DATA_DIR:-}" && "$INTDEMO_DATA_DIR" == /* ]]; then
  layer_store="${INTDEMO_DATA_DIR%/}/uos-layers"
else
  layer_store="${XDG_DATA_HOME:-$HOME/.local/share}/intdemo-client-online-test/uos-layers"
fi
pending_file="$layer_store/pending-version"
attempted_file="$layer_store/pending-attempted"
pending_pid_file="$layer_store/pending-pid"
current_file="$layer_store/current-version"

if [[ "${1:-}" == "--intdemo-apply-layer" ]]; then
  parent_pid="${2:-}"
  if (($# >= 2)); then
    shift 2
  else
    shift
  fi
  if [[ "$parent_pid" =~ ^[1-9][0-9]*$ ]]; then
    for _wait_index in {1..300}; do
      kill -0 "$parent_pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
fi

pending_version="$(head -n 1 "$pending_file" 2>/dev/null || true)"
attempted_version="$(head -n 1 "$attempted_file" 2>/dev/null || true)"
if layer_candidate_is_valid "$pending_version"; then
  if [[ "$attempted_version" == "$pending_version" ]]; then
    attempted_pid="$(head -n 1 "$pending_pid_file" 2>/dev/null || true)"
    attempted_program="$(readlink -f "$layer_store/versions/$pending_version/app/intdemo-client" 2>/dev/null || true)"
    running_program=""
    if [[ "$attempted_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$attempted_pid" 2>/dev/null; then
      running_program="$(readlink -f "/proc/$attempted_pid/exe" 2>/dev/null || true)"
    fi
    if [[ -n "$attempted_program" && "$running_program" == "$attempted_program" ]]; then
      # Another click arrived while the pending version is still starting.
      # Keep its trial state instead of incorrectly treating it as a crash.
      exit 0
    fi
    # The pending version reached the launcher once but never confirmed a
    # successful UI startup. Drop only the activation markers and fall back to
    # the last confirmed version (or the DEB seed); keep files for diagnostics.
    rm -f -- "$pending_file" "$attempted_file" "$pending_pid_file"
  else
    mkdir -p "$layer_store"
    attempted_tmp="$layer_store/.pending-attempted.$$"
    printf '%s\n' "$pending_version" > "$attempted_tmp"
    chmod 0600 "$attempted_tmp" 2>/dev/null || true
    mv -f -- "$attempted_tmp" "$attempted_file"
    pending_pid_tmp="$layer_store/.pending-pid.$$"
    printf '%s\n' "$$" > "$pending_pid_tmp"
    chmod 0600 "$pending_pid_tmp" 2>/dev/null || true
    mv -f -- "$pending_pid_tmp" "$pending_pid_file"
    selected_root="$layer_store/versions/$pending_version"
    selected_version="$pending_version"
    pending_launch=1
  fi
elif [[ -n "$pending_version" ]]; then
  rm -f -- "$pending_file" "$attempted_file" "$pending_pid_file"
fi

if ((pending_launch == 0)); then
  current_version="$(head -n 1 "$current_file" 2>/dev/null || true)"
  if layer_candidate_is_valid "$current_version"; then
    selected_root="$layer_store/versions/$current_version"
    selected_version="$current_version"
  fi
fi

bundled_browser="$selected_root/browser/chrome"
selected_program="$selected_root/app/intdemo-client"
export INTDEMO_PACKAGE_ROOT="$package_root"
export INTDEMO_UOS_LAUNCHER="$package_root/intdemo-client"
if [[ "$selected_root" != "$package_root" ]]; then
  export INTDEMO_LAYER_ROOT="$selected_root"
else
  unset INTDEMO_LAYER_ROOT || true
fi
if ((pending_launch)); then
  export INTDEMO_LAYER_PENDING_VERSION="$selected_version"
else
  unset INTDEMO_LAYER_PENDING_VERSION || true
fi

if [[ -n "${HOME:-}" ]]; then
  launcher_log_dir="${XDG_DATA_HOME:-$HOME/.local/share}/intdemo-client-online-test/logs"
  if mkdir -p "$launcher_log_dir" 2>/dev/null; then
    launcher_log="$launcher_log_dir/launcher.log"
    {
      printf '=== %s pid=%s ===\n' "$(date -Is 2>/dev/null || date)" "$$"
      printf 'desktop_file=%s\n' "${GIO_LAUNCHED_DESKTOP_FILE:-}"
      printf 'package_root=%s\n' "$package_root"
      printf 'selected_root=%s seed_version=%s pending=%s\n' \
        "$selected_root" "$seed_version" "$pending_launch"
      printf 'session=%s display=%s wayland_display=%s qt_platform=%s\n' \
        "${XDG_SESSION_TYPE:-}" "${DISPLAY:-}" "${WAYLAND_DISPLAY:-}" \
        "${QT_QPA_PLATFORM:-}"
    } >>"$launcher_log" 2>&1 || true
  fi
fi

if [[ -x "$bundled_browser" ]]; then
  export INTDEMO_CHROMIUM_PATH="${INTDEMO_CHROMIUM_PATH:-$bundled_browser}"
fi
if [[ -z "${INTDEMO_CONNECTION_CONFIG:-}" ]]; then
  if [[ -f "$user_connection_config" ]]; then
    export INTDEMO_CONNECTION_CONFIG="$user_connection_config"
  elif [[ -f "$bundled_connection_config" ]]; then
    export INTDEMO_CONNECTION_CONFIG="$bundled_connection_config"
  fi
fi

# UOS 20 Wayland normally provides XWayland.  Its application launcher may
# inject QT_QPA_PLATFORM=wayland even though the bundled Qt has no Wayland
# plugin, so treat that inherited value as unsafe and force XCB.  A deliberate
# native Wayland test must use the project-specific override below.
if [[ -n "${INTDEMO_QT_QPA_PLATFORM:-}" ]]; then
  export QT_QPA_PLATFORM="$INTDEMO_QT_QPA_PLATFORM"
elif [[ "${XDG_SESSION_TYPE:-}" == "wayland" && -n "${DISPLAY:-}" ]]; then
  case "${QT_QPA_PLATFORM:-}" in
    ""|wayland|wayland-egl) export QT_QPA_PLATFORM=xcb ;;
  esac
fi
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" && -n "${DISPLAY:-}" ]]; then
  export INTDEMO_CHROMIUM_OZONE_PLATFORM="${INTDEMO_CHROMIUM_OZONE_PLATFORM:-x11}"
fi
export QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-1}"

# Qt 5's XCB backend does not infer the UOS Fcitx service reliably from every
# desktop launcher.  Respect an explicit module, mirror IBus when configured,
# and otherwise use the bundled Fcitx/Fcitx5 platform input context.
if [[ -z "${QT_IM_MODULE:-}" ]]; then
  input_method_hint="${GTK_IM_MODULE:-} ${XMODIFIERS:-} ${INPUT_METHOD:-}"
  if [[ "${input_method_hint,,}" == *ibus* ]]; then
    export QT_IM_MODULE=ibus
  else
    export QT_IM_MODULE=fcitx
  fi
fi
if [[ "$QT_IM_MODULE" == fcitx && -z "${XMODIFIERS:-}" ]]; then
  export XMODIFIERS=@im=fcitx
fi

if [[ -n "$launcher_log" ]]; then
  printf 'effective_qt_platform=%s qt_im_module=%s chromium_ozone=%s\n' \
    "${QT_QPA_PLATFORM:-}" "${QT_IM_MODULE:-}" \
    "${INTDEMO_CHROMIUM_OZONE_PLATFORM:-}" \
    >>"$launcher_log" 2>&1 || true
fi

if [[ -n "$launcher_log" ]]; then
  exec "$selected_program" "$@" 2>>"$launcher_log"
fi
exec "$selected_program" "$@"
