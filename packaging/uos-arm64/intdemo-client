#!/usr/bin/env bash
set -Eeuo pipefail

package_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
bundled_browser="$package_root/browser/chrome"
bundled_connection_config="$package_root/client-online.json"
user_config_root="${XDG_CONFIG_HOME:-$HOME/.config}/intdemo-client"
user_connection_config="$user_config_root/client-online.json"

if [[ -x "$bundled_browser" ]]; then
  export INTDEMO_CHROMIUM_PATH="${INTDEMO_CHROMIUM_PATH:-$bundled_browser}"
fi
if [[ -z "${INTDEMO_CONNECTION_CONFIG:-}" ]]; then
  if [[ -f "$user_connection_config" ]]; then
    export INTDEMO_CONNECTION_CONFIG="$user_connection_config"
  elif [[ -f "$bundled_connection_config" ]]; then
    export INTDEMO_CONNECTION_CONFIG="$bundled_connection_config"
  fi
fi

# UOS 20 Wayland normally provides XWayland.  Qt 5's XCB plugin and Chromium's
# X11 path are more reliable on this older desktop stack.  Users can override
# either value before launching when native Wayland has been verified.
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" && -n "${DISPLAY:-}" ]]; then
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
  export INTDEMO_CHROMIUM_OZONE_PLATFORM="${INTDEMO_CHROMIUM_OZONE_PLATFORM:-x11}"
fi
export QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-1}"

exec "$package_root/app/intdemo-client" "$@"
