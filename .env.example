# Copy to .env on the server. This file contains no secrets.
POSTGRES_DB=intdemo
POSTGRES_USER=intdemo
PIP_INDEX_URL=https://pypi.org/simple
INTDEMO_MAINTENANCE_MODE=0

# Domain plan:
SERVER_ADDRESS=api.example.com
CADDY_BIND_ADDRESS=0.0.0.0
CADDYFILE_PATH=./deploy/caddy/Caddyfile.domain

# Public-IP test plan example:
# SERVER_ADDRESS=203.0.113.10
# CADDYFILE_PATH=./deploy/caddy/Caddyfile.ip

# Used by deploy/scripts/configure-docker-firewall.sh during initial rollout.
ADMIN_PUBLIC_CIDR=203.0.113.25/32
